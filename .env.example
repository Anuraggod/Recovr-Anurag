# ==========================================
# RECOVR - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (PostgreSQL)
# e.g., postgresql://username:password@localhost:5432/recovr_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recovr_db

# Razorpay API Credentials
# Get your Test API Keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_for_hmac

# Groq LLM API Configuration (for ultra-fast recovery nudge generation)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_placeholder_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Multi-Channel Nudge Dispatcher (Optional / Mock Integration)
WHATSAPP_API_KEY=placeholder_whatsapp_api_key
WHATSAPP_PHONE_NUMBER_ID=placeholder_whatsapp_phone_id
SMS_PROVIDER_API_KEY=placeholder_sms_api_key

# Security
JWT_SECRET=super_secret_recovr_jwt_key_minimum_32_characters
